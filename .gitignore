# Log di esecuzione: con "[diff] always = True" in ansible.cfg contengono il
# contenuto integrale dei file copiati, chiavi private TLS comprese.
ansible.log
*.retry

# Certificati e chiavi: NON devono finire nel repository.
# Vanno copiati a mano prima dell'esecuzione in:
#   files/
#   roles/master1_helm_cert_manager_install/files/
#
# NOTA: i .pem attualmente presenti sono gia' tracciati da git, quindi queste
# righe non li escludono da sole. Dopo aver ruotato il certificato eseguire:
#   git rm --cached files/*.pem roles/master1_helm_cert_manager_install/files/*.pem
# in modo che la nuova chiave privata resti solo in locale.
files/*.pem
roles/master1_helm_cert_manager_install/files/*.pem

# Collection scaricate localmente
collections/ansible_collections/

# Dashboard
# Le directory restano nel repo (.gitkeep) ma il contenuto generato no:
# state/ contiene i report di check_disk.yml, vendor/ gli asset scaricati
# da ./vendor.sh. Un'esclusione della directory intera impedirebbe a git di
# reincludere il .gitkeep, quindi si escludono i contenuti.
dashboard/__pycache__/
dashboard/state/*
!dashboard/state/.gitkeep
dashboard/static/vendor/*
!dashboard/static/vendor/.gitkeep
